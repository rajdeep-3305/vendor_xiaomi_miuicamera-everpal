cc_prebuilt_library_shared {
    name: "vendor.mediatek.hardware.camera.isphal@1.0",
    owner: "xiaomi",
    system_ext_specific: true,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/system/lib64/vendor.mediatek.hardware.camera.isphal@1.0.so",
