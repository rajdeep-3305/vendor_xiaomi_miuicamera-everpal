soong_namespace {
    imports: [
        "device/xiaomi/miuicamera-everpal",
    ],
}

cc_prebuilt_library_shared {
    name: "libcamera_algoup_jni.xiaomi",
    owner: "xiaomi",
    system_ext_specific: true,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/system/lib64/libcamera_algoup_jni.xiaomi.so",
            ],
            shared_libs: [
                "libgui_shim_miuicamera",
                "libbinder",
                "libcamera_client",
                "libcamera_metadata",
                "libcutils",
                "libgui",
                "liblog",
                "libutils",
                "libvndksupport",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
}

