android_app_import {
    name: "MiuiCamera",
    owner: "xiaomi",
    apk: "proprietary/product/priv-app/MiuiCamera/MiuiCamera.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
}
