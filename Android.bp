                "libcutils",
                "libgui",
                "libhidlbase",
                "liblog",
                "libmedia",
                "libnativehelper",
                "libui",
                "libutils",
                "libvndksupport",
                "vendor.mediatek.hardware.camera.isphal@1.0",
                "libmtkisp_metadata_sys",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
